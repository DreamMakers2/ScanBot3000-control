# Copy to .env and adjust for your own host.

# Web server
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Optional project root override used by scripts/start-teensy-console.sh.
# Use your own clone location; do not commit machine-specific paths.
# APP_HOME=/opt/scanbot3000-control

# Serial/UART configuration overrides.
# These override values from config/settings.json when set.
SERIAL_DEVICE=/dev/serial0
BAUD_RATE=1000000
DATA_BITS=8
PARITY=N
STOP_BITS=1
NEWLINE=\n

# History sizes
CONSOLE_HISTORY=500
METRICS_HISTORY=300
